# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=AQ.Ab8RN6LpIcT3_RHrPadZ7ff8wE_RLBZyXCzyytMug-8rIG3EtA

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: SQLite connection string used by Prisma.
DATABASE_URL="file:./dev.db"

# SESSION_SECRET: Required. Signs the login session cookie — use a long random string.
SESSION_SECRET="change-this-to-a-long-random-string"

# ADMIN_EMAIL / ADMIN_PASSWORD: Optional. Set these before running
# `npm run prisma:seed` to create your login account. Change the password
# afterwards from a trusted device — these are only used at seed time.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-this-password"

# EMAIL_*: Required for account verification emails on self-registration.
# To use Gmail: turn on 2-Step Verification on your Google account, then
# create an "App password" at myaccount.google.com/apppasswords and use
# that 16-character value as EMAIL_PASS (not your normal Gmail password).
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="you@gmail.com"
EMAIL_PASS="your-16-character-app-password"
EMAIL_FROM="Open CAF <you@gmail.com>"
